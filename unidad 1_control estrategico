<script>
(function () {
  function grupoExcluyente(cont, attr) {
    var bs = Array.prototype.slice.call(cont.querySelectorAll("button"));
    function activar(i) {
      bs.forEach(function (o, k) {
        o.setAttribute(attr, String(k === i));
        document.getElementById(o.getAttribute("aria-controls")).hidden = (k !== i);
      });
    }
    bs.forEach(function (b, i) {
      b.addEventListener("click", function () { activar(i); });
      b.addEventListener("keydown", function (e) {
        if (e.key === "ArrowRight") { activar((i + 1) % bs.length); bs[(i + 1) % bs.length].focus(); }
        if (e.key === "ArrowLeft") {
          activar((i - 1 + bs.length) % bs.length);
          bs[(i - 1 + bs.length) % bs.length].focus();
        }
      });
    });
  }

  Array.prototype.forEach.call(document.querySelectorAll(".rotulos"), function (g) {
    grupoExcluyente(g, "aria-selected");
  });
  Array.prototype.forEach.call(document.querySelectorAll(".conmutador, .chinchetas"),
    function (g) { grupoExcluyente(g, "aria-pressed"); });

  Array.prototype.forEach.call(document.querySelectorAll(".carrusel"), function (c) {
    var fichas = Array.prototype.slice.call(c.querySelectorAll(".ficha"));
    var ant = c.querySelector(".ant"), sig = c.querySelector(".sig");
    var cual = c.querySelector(".cual");
    var i = 0;
    function pinta() {
      fichas.forEach(function (f, k) { f.hidden = (k !== i); });
      ant.disabled = (i === 0);
      sig.disabled = (i === fichas.length - 1);
      cual.textContent = (i + 1) + " de " + fichas.length;
    }
    ant.addEventListener("click", function () { if (i > 0) { i--; pinta(); } });
    sig.addEventListener("click", function () { if (i < fichas.length - 1) { i++; pinta(); } });
    pinta();
  });

  var btn = document.getElementById("ir-refs");
  if (btn) {
    btn.addEventListener("click", function () {
      document.getElementById("p11").scrollIntoView({ behavior: "smooth" });
    });
  }
})();
</script>

